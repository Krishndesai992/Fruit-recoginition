# Flask Application Configuration
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=replace-with-a-secure-random-secret-key

# Model & Inference Pipeline Configuration
MODEL_PATH=models/svm_model.pkl
DEFAULT_BACKBONE=resnet50

